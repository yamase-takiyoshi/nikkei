+  const sourceRevenueLabel=normalizeCompanyRevenueLabel(detail?.accountingLabels?.revenue||c?.accountingLabels?.revenue||'');
+  const sourcePrimary=normalizeCompanyPrimaryProfitLabel(detail?.accountingLabels?.primaryProfit||c?.accountingLabels?.primaryProfit||'');
+  const perf=[...(Array.isArray(c?.performance)?c.performance:[]),...(Array.isArray(detail?.annualPerformance)?detail.annualPerformance:[]),...(Array.isArray(detail?.quarterlyPerformance)?detail.quarterlyPerformance:[])];
+  const hasOperating=perf.some(r=>isNum(r?.operatingProfit)),hasOrdinary=perf.some(r=>isNum(r?.ordinaryProfit));
+  const base={
+    kind:'general',revenueLabel:'売上高',revenueShort:'売上',primaryProfitKey:'operatingProfit',primaryProfitLabel:'営業利益',primaryProfitShort:'営業益',
+    primaryMarginLabel:'営業利益率',revenueGrowthLabel:'売上成長率',enterpriseToRevenueLabel:'EV/売上高',revenuePerShareLabel:'1株売上高',labelBasis:'industry',profitLabelBasis:'industry'
+  };
+  let p=base;
+  if(/銀行業|銀行/.test(industry))p={...base,kind:'bank',revenueLabel:'経常収益',revenueShort:'経常収益',primaryProfitKey:'ordinaryProfit',primaryProfitLabel:'経常利益',primaryProfitShort:'経常益',primaryMarginLabel:'経常利益率',revenueGrowthLabel:'経常収益成長率',enterpriseToRevenueLabel:'EV/経常収益',revenuePerShareLabel:'1株当たり経常収益'};
