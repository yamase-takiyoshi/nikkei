+function normalizeCompanyRevenueLabel(label){
+  const raw=String(label||'').normalize('NFKC').replace(/\s+/g,'');
+  if(/^経常収益/.test(raw))return '経常収益';
+  if(/^営業収益/.test(raw))return '営業収益';
+  if(/^売上収益/.test(raw))return '売上収益';
+  if(/^売上高/.test(raw))return '売上高';
+  if(/^営業収入/.test(raw))return '営業収入';
+  if(/^収益/.test(raw))return '収益';
+  return '';
+}
+function normalizeCompanyPrimaryProfitLabel(label){
+  const raw=String(label||'').normalize('NFKC').replace(/\s+/g,'');
+  if(/^経常益|^経常利益/.test(raw))return {key:'ordinaryProfit',label:'経常利益',short:'経常益',margin:'経常利益率'};
+  if(/^営業益|^営業利益/.test(raw))return {key:'operatingProfit',label:'営業利益',short:'営業益',margin:'営業利益率'};
+  return null;
+}
